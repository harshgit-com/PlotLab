rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function isAdmin(){return request.auth != null && request.auth.token.email_verified == true && request.auth.token.email == "plotlab29@gmail.com" && request.auth.token.firebase.sign_in_provider == "google.com";}
  match /branding/{fileName} {
   allow read: if true;
   allow write: if isAdmin() && (request.resource == null || (request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*')));
  }
 }
}