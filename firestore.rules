rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == "plotlab29@gmail.com";
    }

    // Published movie metadata is public to read. Only the verified admin can write.
    match /movies/{movieId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Public settings are readable; only the admin can change them.
    match /siteSettings/{documentId} {
      allow read: if documentId == "public" || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Visitors can post bounded reviews; only the admin can delete them.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(["movieTitle", "name", "text", "stars", "createdAt"])
        && request.resource.data.movieTitle is string
        && request.resource.data.movieTitle.size() > 0
        && request.resource.data.movieTitle.size() <= 120
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 5
        && request.resource.data.text.size() <= 600
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
