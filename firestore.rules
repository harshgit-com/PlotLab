rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function isAdmin(){return request.auth != null && request.auth.token.email_verified == true && request.auth.token.email == "plotlab29@gmail.com";}
  function signedIn(){return request.auth != null;}
  function ownUser(uid){return signedIn() && request.auth.uid == uid;}
  match /movies/{movieId}{allow read:if resource.data.published == true || isAdmin();allow create,update,delete:if isAdmin();}
  match /siteSettings/{documentId}{allow read:if documentId == "public" || isAdmin();allow create,update,delete:if isAdmin();}
  match /adminActivity/{activityId}{allow read:if isAdmin();allow create:if isAdmin() && request.resource.data.actor == request.auth.token.email;allow update,delete:if false;}
  match /reviews/{reviewId}{
   allow read:if true;
   allow create:if request.resource.data.keys().hasAll(["movieTitle","name","text","stars","createdAt"]) && request.resource.data.movieTitle is string && request.resource.data.movieTitle.size()>0 && request.resource.data.movieTitle.size()<=120 && request.resource.data.name is string && request.resource.data.name.size()<=40 && request.resource.data.text is string && request.resource.data.text.size()>=5 && request.resource.data.text.size()<=600 && request.resource.data.stars is int && request.resource.data.stars>=1 && request.resource.data.stars<=5;
   allow update:if false;allow delete:if isAdmin();
  }
  match /users/{uid}{
   allow read:if ownUser(uid)||isAdmin();
   allow create:if ownUser(uid)&&request.resource.data.uid==uid&&request.resource.data.email==request.auth.token.email&&request.resource.data.role in ["viewer","creator"]&&request.resource.data.keys().hasAll(["uid","name","email","role","createdAt","updatedAt"])&&(!request.resource.data.keys().hasAny(["roles"])||(request.resource.data.roles is list&&request.resource.data.roles.size()>=1&&request.resource.data.roles.size()<=2&&request.resource.data.roles.hasAll(["viewer"])&&request.resource.data.roles.hasOnly(["viewer","creator"])));
   allow update:if ownUser(uid)&&request.resource.data.uid==resource.data.uid&&request.resource.data.email==request.auth.token.email&&request.resource.data.role in ["viewer","creator"]&&(!request.resource.data.keys().hasAny(["roles"])||(request.resource.data.roles is list&&request.resource.data.roles.size()>=1&&request.resource.data.roles.size()<=2&&request.resource.data.roles.hasAll(["viewer"])&&request.resource.data.roles.hasOnly(["viewer","creator"])))&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name","email","role","roles","updatedAt"]);
   allow delete:if ownUser(uid)||isAdmin();
  }
  match /creatorProfiles/{uid}{
   // Creator profiles are discoverable to signed-in PlotLab members so they can find collaborators.
   allow read:if signedIn()||isAdmin();
   allow create:if ownUser(uid)&&request.resource.data.uid==uid&&request.resource.data.email==request.auth.token.email&&request.resource.data.keys().hasAll(["uid","name","email","role","experience","portfolio","city","bio","lookingFor","createdAt","updatedAt"])&&request.resource.data.name is string&&request.resource.data.name.size()>0&&request.resource.data.role is string&&request.resource.data.role.size()>0&&request.resource.data.experience is string&&request.resource.data.bio is string&&request.resource.data.bio.size()>0&&request.resource.data.portfolio is string&&request.resource.data.city is string&&request.resource.data.city.size()>0&&request.resource.data.city.size()<=100&&request.resource.data.lookingFor is string;
   allow update:if ownUser(uid)&&request.resource.data.uid==resource.data.uid&&request.resource.data.email==request.auth.token.email&&request.resource.data.keys().hasAll(["uid","name","email","role","experience","portfolio","city","bio","lookingFor","createdAt","updatedAt"])&&request.resource.data.name is string&&request.resource.data.name.size()>0&&request.resource.data.role is string&&request.resource.data.role.size()>0&&request.resource.data.experience is string&&request.resource.data.bio is string&&request.resource.data.bio.size()>0&&request.resource.data.portfolio is string&&request.resource.data.city is string&&request.resource.data.city.size()>0&&request.resource.data.city.size()<=100&&request.resource.data.lookingFor is string;
   allow delete:if ownUser(uid)||isAdmin();
  }
  match /creatorConnections/{connectionId}{
   allow read:if signedIn()&&(resource.data.fromUid==request.auth.uid||resource.data.toUid==request.auth.uid)||isAdmin();
   allow create:if signedIn()&&request.resource.data.fromUid==request.auth.uid&&request.resource.data.fromEmail==request.auth.token.email&&request.resource.data.toUid is string&&request.resource.data.toUid!=request.auth.uid&&request.resource.data.status=="pending"&&request.resource.data.keys().hasAll(["fromUid","fromEmail","fromName","toUid","toEmail","toName","status","createdAt","updatedAt"]);
   allow update:if signedIn()&&resource.data.toUid==request.auth.uid&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","updatedAt"])&&request.resource.data.status in ["accepted","declined"];
   allow delete:if signedIn()&&(resource.data.fromUid==request.auth.uid||resource.data.toUid==request.auth.uid)||isAdmin();
  }
  match /creatorChats/{chatId}{
   allow get:if signedIn()&&(resource==null||request.auth.uid in resource.data.participants);
   allow list:if signedIn()&&request.auth.uid in resource.data.participants;
   allow create:if signedIn()&&request.resource.data.participants is list&&request.resource.data.participants.size()==2&&request.auth.uid in request.resource.data.participants&&request.resource.data.participantNames is map;
   allow update:if signedIn()&&request.auth.uid in resource.data.participants&&request.resource.data.participants==resource.data.participants&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(["participantNames","updatedAt"]);
   allow delete:if false;
   match /messages/{messageId}{
    allow read:if signedIn()&&request.auth.uid in get(/databases/$(database)/documents/creatorChats/$(chatId)).data.participants;
    allow create:if signedIn()&&request.auth.uid in get(/databases/$(database)/documents/creatorChats/$(chatId)).data.participants&&request.resource.data.fromUid==request.auth.uid&&request.resource.data.text is string&&request.resource.data.text.size()>0&&request.resource.data.text.size()<=2000&&request.resource.data.keys().hasAll(["fromUid","fromName","text","createdAt"]);
    allow update,delete:if false;
   }
  }
  match /{document=**}{allow read,write:if false;}
 }
}