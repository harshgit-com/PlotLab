rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function isAdmin(){return request.auth != null && request.auth.token.email_verified == true && request.auth.token.email == "plotlab29@gmail.com";}
  function signedIn(){return request.auth != null;}
  function ownUser(uid){return signedIn() && request.auth.uid == uid;}
  match /movies/{movieId}{allow read:if resource.data.published == true || isAdmin();allow create,update,delete:if isAdmin();}
  match /siteSettings/{documentId}{allow read:if documentId == "public" || isAdmin();allow create,update,delete:if isAdmin();}
  match /adminActivity/{activityId}{allow read:if isAdmin();allow create:if isAdmin() && request.resource.data.actor == request.auth.token.email;allow update,delete:if false;}
  match /reviews/{reviewId}{
   allow read:if true;
   allow create:if request.resource.data.keys().hasAll(["movieTitle","name","text","stars","createdAt"]) && request.resource.data.movieTitle is string && request.resource.data.movieTitle.size()>0 && request.resource.data.movieTitle.size()<=120 && request.resource.data.name is string && request.resource.data.name.size()<=40 && request.resource.data.text is string && request.resource.data.text.size()>=5 && request.resource.data.text.size()<=600 && request.resource.data.stars is int && request.resource.data.stars>=1 && request.resource.data.stars<=5;
   allow update:if false;allow delete:if isAdmin();
  }
  match /users/{uid}{
   allow read:if ownUser(uid)||isAdmin();
   allow create:if ownUser(uid)&&request.resource.data.uid==uid&&request.resource.data.email==request.auth.token.email&&request.resource.data.role in ["viewer","creator"]&&request.resource.data.keys().hasAll(["uid","name","email","role","createdAt","updatedAt"]);
   allow update:if ownUser(uid)&&request.resource.data.uid==resource.data.uid&&request.resource.data.email==resource.data.email&&((request.resource.data.role==resource.data.role&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name","updatedAt"]))||(resource.data.role=="viewer"&&request.resource.data.role=="creator"&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name","role","updatedAt"])));
   allow delete:if ownUser(uid)||isAdmin();
  }
  match /creatorProfiles/{uid}{
   allow read:if ownUser(uid)||isAdmin();
   allow create:if ownUser(uid)&&get(/databases/$(database)/documents/users/$(uid)).data.role=="creator"&&request.resource.data.uid==uid&&request.resource.data.email==request.auth.token.email;
   allow update:if ownUser(uid)&&get(/databases/$(database)/documents/users/$(uid)).data.role=="creator"&&request.resource.data.uid==resource.data.uid&&request.resource.data.email==resource.data.email;
   allow delete:if ownUser(uid)||isAdmin();
  }
  match /{document=**}{allow read,write:if false;}
 }
}